{
    // IntelliSense を使用して利用可能な属性を学べます。
    // 既存の属性の説明をホバーして表示します。
    // 詳細情報は次を確認してください: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.0.1",
    "compounds": [
        {
            "name": "server + web",
            "configurations": [
                "Python: cmdbox server",
                "Python: cmdbox web"]
        },
        {
            "name": "server + web + mcp",
            "configurations": [
                "Python: cmdbox server",
                "Python: cmdbox server2",
                "Python: cmdbox web",
                "Python: cmdbox mcpsv"]
        },
        {
            "name": "server + web + mcp + a2a",
            "configurations": [
                "Python: cmdbox server",
                "Python: cmdbox server2",
                "Python: cmdbox web",
                "Python: cmdbox mcpsv",
                "Python: cmdbox a2asv"
            ]
        }
    ],
    "configurations": [
        {
            "name": "Python: cmdbox server",
            "type": "python",
            "request": "launch",
            "args": ["-m","server","-c","start","--debug", "--data", "./.server_data"],
            "module": "cmdbox",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Python: cmdbox server2",
            "type": "python",
            "request": "launch",
            "args": ["-m","server","-c","start","--debug", "--data", "./.server_data"],
            "module": "cmdbox",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Python: cmdbox web",
            "type": "python",
            "request": "launch",
            "args": ["-m","web","-c","start","--signin_file",".cmdbox/user_list.yml",
                    "--ssl_cert","idp_cert.pem","--ssl_key","idp_private.pem",
                     "--debug", "--gunicorn_workers", "5", "--data", "./.client_data"],
            "module": "cmdbox",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Python: cmdbox mcpsv",
            "type": "python",
            "request": "launch",
            "args": ["-m","mcpsv","-c","start","--signin_file",".cmdbox/user_list.yml",
                     "--debug", "--gunicorn_workers", "5", "--data", "./.client_data"],
            "module": "cmdbox",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Python: cmdbox a2asv",
            "type": "python",
            "request": "launch",
            "args": ["-m","a2asv","-c","start","--signin_file",".cmdbox/user_list.yml",
                     "--debug", "--gunicorn_workers", "5", "--data", "./.client_data"],
            "module": "cmdbox",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Python: cmdbox edge config",
            "type": "python",
            "request": "launch",
            "args": ["-m","edge","-c","config","--debug"],
            "module": "cmdbox",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Python: cmdbox edge start",
            "type": "python",
            "request": "launch",
            "args": ["-m","edge","-c","start"],
            "module": "cmdbox",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        },
        {
            "name": "Python: cmdbox cmdbox setup",
            "type": "python",
            "request": "launch",
            "args": ["-m","cmdbox","-c","setup","--data",".server_data","--chopt","data=.client_data","--chopt","client_data=.client_data"],
            "module": "cmdbox",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}